# Place at the root of the repo (Jam-Games/).
# Assumes each Unity project is a direct subfolder: Jam-Games/<ProjectName>/
# "/*/" matches exactly one directory level, so these rules apply per project
# without catching same-named folders deeper inside Assets/.
# If a project is nested deeper, use "/*/*/" for those rules.

# ---------- OS / editor ----------
.DS_Store
.utmp/
.vs/
.gradle/
*.log
*.tmp
*.user
*.userprefs
*.DotSettings.user

# ---------- Unity generated folders (per project) ----------
/*/[Ll]ibrary/
/*/[Tt]emp/
/*/[Oo]bj/
/*/[Bb]uild/
/*/[Bb]uilds/
/*/[Ll]ogs/
/*/[Uu]ser[Ss]ettings/
/*/[Mm]emoryCaptures/
/*/[Rr]ecordings/

# ---------- Blender ----------
*.blend1
*.blend1.meta

# ---------- Autogenerated IDE project files ----------
/*/[Aa]ssets/Plugins/Editor/JetBrains*
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------- Unity generated meta files ----------
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------- Crash / mono ----------
sysinfo.txt
mono_crash.*

# ---------- Builds ----------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
crashlytics-build.properties

# ---------- Test runner ----------
InitTestScene*.unity*
/*/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ---------- Addressables ----------
/*/ServerData
/*/[Aa]ssets/StreamingAssets/aa*
/*/[Aa]ssets/AddressableAssetsData/link.xml*
/*/[Aa]ssets/Addressables_Temp*
/*/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ---------- Visual Scripting ----------
/*/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/*/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/*/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/*/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ---------- Scene dependency cache ----------
/*/[Aa]ssets/[Ss]ceneDependencyCache*